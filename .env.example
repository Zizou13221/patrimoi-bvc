# PatriMoi — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs.
# NE JAMAIS committer .env (il est dans .gitignore).

# ── Supabase ──────────────────────────────────────────────────────────────────
# URL du projet Supabase (visible dans Settings > API)
SUPABASE_URL=https://VOTRE_PROJECT_REF.supabase.co

# Clé anon (publique côté client — visible dans les bundles JS, comportement normal)
# Sécurité assurée par RLS, pas par le secret de cette clé.
# À ne pas confondre avec la clé service_role (secrète, jamais côté client).
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI...

# ── Apple / Fastlane ──────────────────────────────────────────────────────────
# (Pour les builds iOS — voir docs/testflight.md)
# APPLE_ID=votre@email.com
# TEAM_ID=XXXXXXXXXX
# ITC_TEAM_ID=XXXXXXXXXX
# APP_STORE_CONNECT_KEY_ID=XXXXXXXXXX
# APP_STORE_CONNECT_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# APP_STORE_CONNECT_KEY_CONTENT=LS0tLS1CRUdJTi...
# MATCH_GIT_URL=git@github.com:VOTRE_USER/patrimoi-certs.git
# MATCH_PASSWORD=mot_de_passe_chiffrement
